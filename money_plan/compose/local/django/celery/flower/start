#!/bin/bash

set -o errexit
set -o nounset


until timeout 10 celery -A config.celery_app inspect ping; do
    >&2 echo "Celery workers not available"
done

echo 'Starting flower'


# Only watch our own code, not .venv / node_modules (that pegged a CPU core).
exec watchfiles --filter python \
    --args \
    "-A config.celery_app -b \"${REDIS_URL}\" flower --basic_auth=\"${CELERY_FLOWER_USER}:${CELERY_FLOWER_PASSWORD}\"" \
    celery.__main__.main money_plan config
