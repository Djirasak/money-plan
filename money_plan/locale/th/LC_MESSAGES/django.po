msgid "e.g."
msgstr "เช่น"

msgid "Date"
msgstr "วันที่"

msgid "Type"
msgstr "ชนิด"

msgid "From pile"
msgstr "จากกอง"

msgid "To pile"
msgstr "เข้ากอง"

msgid "Amount (THB)"
msgstr "จำนวน (บาท)"

msgid "Note (optional)"
msgstr "โน้ต (ไม่บังคับ)"

msgid "Amount must be greater than 0"
msgstr "จำนวนต้องมากกว่า 0"

msgid "A spend entry needs only a 'From pile'"
msgstr "รายการจ่ายต้องเลือก 'จากกอง' อย่างเดียว"

msgid "A transfer needs both a 'From pile' and a 'To pile'"
msgstr "การย้ายเงินต้องเลือกทั้ง 'จากกอง' และ 'เข้ากอง'"

msgid "An adjustment needs either a 'From pile' or a 'To pile', not both"
msgstr "การปรับยอดเลือกได้อย่างใดอย่างหนึ่ง (จากกอง หรือ เข้ากอง)"

msgid "The source and target piles must differ"
msgstr "กองต้นทางและปลายทางต้องไม่เหมือนกัน"

msgid "Unlimited"
msgstr "ไม่จำกัด"

msgid "Pile name"
msgstr "ชื่อกอง"

msgid "Pile color"
msgstr "สีประจำกอง"

msgid "Leftover mode"
msgstr "โหมดยอดเหลือ"

msgid "Rollover cap (empty = unlimited)"
msgstr "เพดานทบ (ว่าง = ไม่จำกัด)"

msgid "Overflow pile"
msgstr "กองที่ล้นไป"

msgid "Target amount (THB)"
msgstr "จำนวนเป้าหมาย (บาท)"

msgid "Share of salary (%)"
msgstr "สัดส่วนของเงินเดือน (%)"

msgid "Months of salary"
msgstr "จำนวนเดือน"

msgid "Order"
msgstr "ลำดับ"

msgid "No target"
msgstr "ไม่มีเป้าหมาย"

msgid "A fixed amount"
msgstr "จำนวนเงินคงที่"

msgid "A share of my salary x months"
msgstr "สัดส่วนของเงินเดือน × จำนวนเดือน"

msgid "Target"
msgstr "เป้าหมาย"

msgid "Enter the target amount"
msgstr "กรอกจำนวนเงินเป้าหมาย"

msgid "Enter a percentage of your salary"
msgstr "กรอกเปอร์เซ็นต์ของเงินเดือน"

msgid "Enter the number of months"
msgstr "กรอกจำนวนเดือน"

msgid "A pile with this name already exists"
msgstr "ชื่อกองนี้มีอยู่แล้ว"

#, python-format
msgid "You can add at most %(max)s salaries"
msgstr "เพิ่มเงินเดือนได้ไม่เกิน %(max)s แถว"

msgid "This pile has no target. Set one on the Piles tab or enter an amount."
msgstr "กองนี้ยังไม่ได้ตั้งเป้าหมาย ตั้งได้ที่แท็บกองเงิน หรือกรอกจำนวนเงินเอง"

msgid "Choose a pile, a comparison and an amount for the condition"
msgstr "เลือกกอง เงื่อนไข และจำนวนเงินสำหรับเงื่อนไข"

msgid "Summary"
msgstr "สรุป"

msgid "Log"
msgstr "บันทึก"

msgid "Settings"
msgstr "ตั้งค่า"

msgid "Month must be in YYYY-MM format"
msgstr "รูปแบบเดือนต้องเป็น YYYY-MM"

msgid "Color must be #rrggbb"
msgstr "สีต้องเป็น #rrggbb"

msgid "Pile name cannot start with = + - or @"
msgstr "ชื่อกองห้ามขึ้นต้นด้วย = + - @"

msgid "Pile name contains invalid characters"
msgstr "ชื่อกองมีอักขระที่ใช้ไม่ได้"

msgid "Monthly budget"
msgstr "งบรายเดือน"

msgid "Savings fund"
msgstr "กองสะสม"

msgid "Sweep to another pile"
msgstr "กวาดไปกองอื่น"

msgid "Rollover"
msgstr "ทบได้"

msgid "Rollover cap"
msgstr "เพดานทบ"

msgid "has at least"
msgstr "มีอย่างน้อย"

msgid "is below"
msgstr "ต่ำกว่า"

msgid "Spend"
msgstr "จ่าย"

msgid "Transfer"
msgstr "ย้ายเงิน"

msgid "Sweep"
msgstr "กวาดยอด"

msgid "Adjust"
msgstr "ปรับยอด"

msgid "Reserve"
msgstr "เงินสำรอง"

msgid "Expenses"
msgstr "ค่าใช้จ่าย"

msgid "Spending money"
msgstr "เงินใช้ฟรี"

msgid "Build the reserve"
msgstr "สะสมเงินสำรอง"

#, python-format
msgid "%(percent)s%% of salary x %(months)s months"
msgstr "%(percent)s%% ของเงินเดือน × %(months)s เดือน"

msgid "Entry saved"
msgstr "บันทึกรายการแล้ว"

msgid "Entry deleted"
msgstr "ลบรายการแล้ว"

msgid "Salary saved"
msgstr "บันทึกเงินเดือนแล้ว"

msgid "Invalid value"
msgstr "ค่าที่กรอกไม่ถูกต้อง"

msgid "Settings saved"
msgstr "บันทึกการตั้งค่าแล้ว"

msgid "Pile saved"
msgstr "บันทึกกองแล้ว"

msgid "Cannot delete: this pile is used by log entries or a plan condition"
msgstr "ลบไม่ได้: กองนี้ถูกใช้ในรายการบันทึกหรือเงื่อนไขของแผน"

msgid "Pile deleted"
msgstr "ลบกองแล้ว"

msgid "Plan added"
msgstr "เพิ่มแผนแล้ว"

msgid "Plan saved"
msgstr "บันทึกแผนแล้ว"

msgid "Plan deleted"
msgstr "ลบแผนแล้ว"

msgid "Access denied (403)"
msgstr "ไม่มีสิทธิ์เข้าถึง (403)"

msgid "You can't go in here"
msgstr "ตรงนี้เข้าไม่ได้นะ"

msgid "You don't have permission to open this page. Try signing in with the right account, or go back home."
msgstr "คุณไม่มีสิทธิ์เปิดหน้านี้ ลองเข้าสู่ระบบด้วยบัญชีที่ถูกต้อง หรือกลับไปหน้าหลัก"

msgid "Form expired (403)"
msgstr "แบบฟอร์มหมดอายุ (403)"

msgid "The form has expired"
msgstr "แบบฟอร์มหมดอายุแล้ว"

msgid "This page was open for too long. Refresh it and try again."
msgstr "หน้านี้เปิดค้างไว้นานเกินไป รีเฟรชหน้าแล้วลองส่งอีกครั้งนะ"

msgid "Refresh page"
msgstr "รีเฟรชหน้า"

msgid "Back to home"
msgstr "กลับหน้าหลัก"

msgid "Page not found (404)"
msgstr "ไม่พบหน้านี้ (404)"

msgid "We can't find that page"
msgstr "หาหน้านี้ไม่เจอ"

msgid "The coin rolled away somewhere. The link may be wrong, or the page has moved."
msgstr "เหรียญกลิ้งหายไปไหนไม่รู้ ลิงก์อาจผิด หรือหน้านี้ถูกย้ายไปแล้ว"

msgid "Something went wrong (500)"
msgstr "เกิดข้อผิดพลาด (500)"

msgid "We hit a small bump"
msgstr "ระบบสะดุดนิดหน่อย"

msgid "Something went wrong on our side and it has been logged. Try refreshing; if it keeps happening, come back a little later."
msgstr "มีบางอย่างผิดพลาดฝั่งเรา ระบบบันทึกปัญหาไว้แล้ว ลองรีเฟรชอีกครั้ง ถ้ายังเป็นอยู่ค่อยกลับมาใหม่นะ"

msgid "Try again"
msgstr "ลองใหม่"

msgid "Sign In"
msgstr "เข้าสู่ระบบ"

msgid "Search..."
msgstr "ค้นหา..."

msgid "No results found"
msgstr "ไม่พบผลลัพธ์"

msgid "No choices to choose from"
msgstr "ไม่มีตัวเลือก"

msgid "Notifications"
msgstr "การแจ้งเตือน"

msgid "Dismiss"
msgstr "ปิด"

msgid "Loading..."
msgstr "กำลังโหลด..."

msgid "Go back"
msgstr "ย้อนกลับ"

msgid "Add new"
msgstr "เพิ่มใหม่"

msgid "Save"
msgstr "บันทึก"

msgid "Month"
msgstr "เดือน"

msgid "Year"
msgstr "ปี"

#, python-format
msgid "The target follows your salary: it changes whenever your salary changes. Example: 60%% x 6 months = 6 months of 60%% of your salary."
msgstr "เป้าหมายจะเปลี่ยนตามเงินเดือนของคุณ ทุกครั้งที่เงินเดือนเปลี่ยน เช่น 60%% × 6 เดือน = เงินเดือน 60%% เป็นเวลา 6 เดือน"

msgid "When to use this plan"
msgstr "เมื่อไหร่ที่ใช้แผนนี้"

msgid "Always, from the start month"
msgstr "ใช้เสมอ ตั้งแต่เดือนที่เริ่ม"

msgid "Only while a pile's balance matches"
msgstr "ใช้เมื่อยอดของกองใดกองหนึ่งตรงเงื่อนไข"

msgid "Pile"
msgstr "กอง"

msgid "Comparison"
msgstr "การเปรียบเทียบ"

msgid "Use the target of this pile"
msgstr "ใช้เป้าหมายของกองนี้"

msgid "Checked at the start of each month. If the condition is not met, the next older plan is used."
msgstr "ตรวจทุกต้นเดือน ถ้าไม่ตรงเงื่อนไข จะใช้แผนที่เก่ากว่าถัดไปแทน"

msgid "General"
msgstr "ทั่วไป"

msgid "Piles"
msgstr "กองเงิน"

msgid "Budget plan"
msgstr "แผนแบ่งเงิน"

msgid "Salary"
msgstr "เงินเดือน"

