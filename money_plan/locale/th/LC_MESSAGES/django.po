msgstr "เดือนที่เริ่มใช้"

msgid "Save salary"
msgstr "บันทึกเงินเดือน"

msgid "Preferences"
msgstr "การตั้งค่าส่วนตัว"

#, python-format
msgid "Switch language to %(name)s"
msgstr "เปลี่ยนภาษาเป็น %(name)s"

