msgstr "เพิ่มรายการ"

msgid "Spend: pick \"From pile\" · Transfer/Sweep: pick both · Adjust: pick one"
msgstr "จ่าย: เลือก \"จากกอง\" · ย้าย/กวาด: เลือกทั้งสอง · ปรับยอด: เลือกอย่างใดอย่างหนึ่ง"

msgid "Save changes"
msgstr "บันทึกการแก้ไข"

#, python-format
msgid "Entries %(m)s"
msgstr "รายการ %(m)s"

msgid "Edit"
msgstr "แก้"

msgid "Delete this entry?"
msgstr "ลบรายการนี้?"

msgid "No entries this month yet"
msgstr "ยังไม่มีรายการในเดือนนี้"

msgid "Your plan"
msgstr "แผนของคุณ"

msgid "Plan starts from"
msgstr "เริ่มวางแผนตั้งแต่"

