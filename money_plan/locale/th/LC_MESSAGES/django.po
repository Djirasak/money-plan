#, python-format
msgid "Rollover up to %(cap)s"
msgstr "ทบได้ไม่เกิน %(cap)s"

msgid "Rollover, unlimited"
msgstr "ทบได้ไม่จำกัด"

#, python-format
msgid "Overflow %(amount)s to %(target)s"
msgstr "ล้น %(amount)s ไปยัง %(target)s"

