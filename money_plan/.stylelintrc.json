{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["**/*.min.css", "node_modules/**", "staticfiles/**"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      { "ignoreAtRules": ["theme", "source", "utility", "variant", "custom-variant", "plugin", "apply", "config", "reference"] }
    ],
    "import-notation": null
  }
}
