{
  "extends": ["stylelint-config-recommended"],
  "ignoreFiles": ["**/*.min.css", "node_modules/**", "staticfiles/**"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      { "ignoreAtRules": ["theme", "source", "utility", "variant", "custom-variant", "plugin", "apply", "config", "reference"] }
    ],
    "at-rule-prelude-no-invalid": null,
    "no-duplicate-selectors": null,
    "no-descending-specificity": null
  }
}
